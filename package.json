{
  "name": "standshare-mcp",
  "version": "1.0.0",
  "description": "MCP server for StandShare API — composable domain tools for org admins, coordinators, and support staff",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "standshare-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/resources build/resources",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
