{
  "name": "standshare-mcp",
  "version": "1.0.0",
  "description": "MCP server for StandShare API — composable domain tools for org admins, coordinators, and support staff",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "standshare-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "standshare",
    "claude",
    "ai-tools",
    "fundraising"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonCarter80/standshare-mcp.git"
  },
  "homepage": "https://github.com/JasonCarter80/standshare-mcp#readme",
  "scripts": {
    "build": "tsc && mkdir -p build/resources && cp -r src/resources/* build/resources/",
    "prepublishOnly": "npm run build",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
